# --- Ключ Hugging Face (обязателен). Создать: https://huggingface.co/settings/tokens ---
# Нужны права на Inference Providers. Файл .env в git НЕ попадает.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Модель и провайдер (обычно менять не нужно) ---
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=deepseek-ai/DeepSeek-V4-Pro
HF_TIMEOUT=120

# --- Проверка ключа при старте ---
# HF_VERIFY_ON_STARTUP: живая проверка ключа через router при запуске (on/off)
# HF_STRICT_STARTUP:  on = отклонённый ключ (401) не даёт контейнеру подняться
HF_VERIFY_ON_STARTUP=on
HF_STRICT_STARTUP=off

# --- Приложение ---
# SECRET_KEY — на будущее (сессии/подписи); сейчас не используется
SECRET_KEY=
SYSTEM_PROMPT=Ты — личный ИИ-ассистент владельца сервера. Отвечай по-русски, кратко и по делу.
MAX_MESSAGE_CHARS=16000
HISTORY_LIMIT=20
ALLOWED_ORIGINS=*
LOG_LEVEL=INFO

# --- База данных (необязательно: только для profile db) ---
DATABASE_URL=postgresql://jbai:change-me@db:5432/jbai
POSTGRES_DB=jbai
POSTGRES_USER=jbai
POSTGRES_PASSWORD=change-me
